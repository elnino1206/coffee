APP_NAME="Al Jar Coffee"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Проект работает на PostgreSQL. Контейнер разработки поднимается так:
# docker run -d --name aljar-postgres --restart unless-stopped \
#   -e POSTGRES_USER=aljar -e POSTGRES_PASSWORD=<пароль> -e POSTGRES_DB=aljar \
#   -p 127.0.0.1:5434:5432 -v aljar-pgdata:/var/lib/postgresql/data postgres:17-alpine
# Тесты идут в отдельную базу aljar_test (см. phpunit.xml), её нужно создать:
# docker exec aljar-postgres psql -U aljar -d aljar -c 'CREATE DATABASE aljar_test OWNER aljar;'
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=aljar
DB_USERNAME=aljar
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# На боевом сервере: MAIL_MAILER=smtp плюс хост, порт, логин и пароль
# почтового ящика. Пока стоит log — письма пишутся в storage/logs и
# никуда не уходят, поэтому подтверждение почты и смена пароля работают
# только в разработке.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@aljar.ru"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
